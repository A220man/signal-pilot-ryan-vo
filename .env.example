# Signal Pilot — demo-mode configuration
# Copy to .env and adjust. Leave blank for default demo (localhost, no auth).

# Demo mode: binds to localhost only, no authentication required.
# REFUSES to start in production (non-localhost) when demo_mode=true.
DEMO_MODE=true

# SQLite database file
DATABASE_URL=sqlite:///./data/signal_pilot.db

# Backend server
HOST=127.0.0.1
PORT=8000

# Frontend dev server (Vite)
FRONTEND_PORT=5173

# LLM settings (optional — for opt-in advisory explanations)
LLM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=

# Keycloak OIDC settings (planned for future auth implementation)
KEYCLOAK_SERVER_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=http://localhost:5173/callback
KEYCLOAK_PUBLIC_CLIENT=true